{
  "exclude": [
    "node_repl"
  ],
  "recipes": {
    "markitdown": {
      "python": "3.14.7",
      "packages": [
        "markitdown-mcp==0.0.1a7"
      ],
      "command": "${ROOT}/.local/servers/markitdown/Scripts/python.exe",
      "args": [
        "-m",
        "markitdown_mcp"
      ]
    },
    "google-scholar": {
      "venv": "markitdown",
      "python": "3.14.7",
      "packages": [
        "mcp>=2,<3",
        "scholarly>=1.7.0,<2",
        "bibtexparser>=1.4,<2",
        "requests>=2,<3",
        "beautifulsoup4>=4,<5"
      ],
      "command": "${ROOT}/.local/servers/markitdown/Scripts/python.exe",
      "args": [
        "${ROOT}/.local/sources/google-scholar/google_scholar_server.py"
      ],
      "install": [
        [
          "${PYTHON}",
          "${ROOT}/scripts/install_google_scholar.py"
        ]
      ]
    },
    "semgrep": {
      "installer": "pipx",
      "python": "3.14.7",
      "package": "semgrep==1.178.0",
      "command": "${PIPX_BIN}/semgrep.exe",
      "args": [
        "mcp"
      ],
      "install": [
        [
          "${PIPX_VENVS}/semgrep/Scripts/python.exe",
          "${ROOT}/scripts/patch_semgrep_timeout.py"
        ]
      ]
    }
  }
}
